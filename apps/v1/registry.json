          "card-foreground": "#ececec",
          "popover": "#1c1c1c",
          "popover-foreground": "#ececec",
          "primary": "#3e6ae1",
          "primary-foreground": "#ffffff",
          "secondary": "#242424",
          "secondary-foreground": "#f5f5f5",
          "muted": "#242424",
          "muted-foreground": "#9a9a9a",
