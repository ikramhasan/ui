          "muted": "#f5f5f5",
          "muted-foreground": "#6e6e6e",
          "accent": "#f2f2f2",
          "accent-foreground": "#333333",
          "destructive": "#d42f2f",
          "border": "#ebebeb",
          "input": "#e0e0e0",
          "ring": "#0077e6",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
