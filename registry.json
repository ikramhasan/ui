      "description": "The registry design as a shadcn style: neutral surfaces, hairline borders, one blue for action. Light and dark, set in Inter.",
      "registryDependencies": [
        "font-inter"
      ],
      "cssVars": {
        "theme": {
          "color-success": "var(--success)"
        },
        "light": {
          "radius": "0.625rem",
          "background": "#ffffff",
          "foreground": "#333333",
          "card": "#ffffff",
          "card-foreground": "#333333",
          "popover": "#ffffff",
          "popover-foreground": "#333333",
          "primary": "#3e6ae1",
